# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration — placeholders only.
# NEVER commit real values. Set these in your hosting platform
# (Vercel → Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Drizzle ORM reads this in src/db/index.ts).
# Example shape:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database

# DevTools admin session signing secret (src/lib/devtools/session.ts).
# - REQUIRED for production: without it the /devtools dashboard fails
#   closed (login returns 503) and no session can be verified.
# - Development: if unset, a dev-only fallback secret is used (with a
#   console warning) so local work is possible.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-at-least-32-random-characters
